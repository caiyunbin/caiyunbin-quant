# ============================================================
# 双保险: 任何含敏感信息的文件类型都 ban 掉
# ============================================================
# Python 引擎源代码 — 绝对不能上 GitHub
*.py
*.pyc
__pycache__/
*.pyo
*.pyd

# 数据 — 绝对不能上 GitHub
# events.json / hype.json 改为单机大脑直接写网站目录, 不再入库 (防 git reset --hard 覆盖本地实时数据)
data/events.json
data/hype.json
*.parquet
*.db
*.sqlite
*.sqlite3
*.h5
*.feather
*.csv  # 除非显式 force-add 必要的小 csv
*.tsv
*.xlsx
*.xls

# 密钥 / 环境变量 — 绝对不能上 GitHub
.env
.env.*
secrets/
*.key
*.pem
*.cer
*.p12
*token*
*secret*
*password*
*.cred

